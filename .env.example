# Copie para .env e ajuste. Nunca envie o .env para o GitHub.

# Onde fica o banco SQLite (use um disco persistente em produção)
DATABASE_PATH=./data/cardapio.db

# Conta de superadministrador (você) — usada por `npm run seed`
SUPERADMIN_EMAIL=voce@seudominio.com.br
SUPERADMIN_PASSWORD=troque-esta-senha-forte

# Acesso do painel da pizzaria de demonstração
DEMO_OWNER_EMAIL=admin@brasaemassa.demo
DEMO_OWNER_PASSWORD=pizza1234

# Seu WhatsApp comercial (botões "Quero para minha loja" da página de vendas)
NEXT_PUBLIC_SALES_WHATSAPP=
# true = mostra o login do painel de demonstração na página de vendas
NEXT_PUBLIC_SHOW_DEMO_LOGIN=false

# Só para testes locais em produção sem HTTPS (NUNCA use em um servidor público)
# INSECURE_COOKIES=true
